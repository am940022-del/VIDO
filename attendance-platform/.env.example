# انسخ هذا الملف إلى .env وعدّل القيم (سكربت deploy/install.sh يفعل ذلك تلقائياً)

# اسم النطاق الذي سيعمل عليه الموقع (يجب أن يشير سجل DNS من نوع A إلى عنوان الخادم)
DOMAIN=attendance.example.com

# المنطقة الزمنية للمدارس (لتحديد تاريخ "اليوم")، مثل Asia/Muscat أو Asia/Riyadh
SCHOOL_TZ=Asia/Muscat

# رمز الدولة الافتراضي لأرقام أولياء الأمور في المدارس الجديدة (968 عُمان، 966 السعودية)
DEFAULT_COUNTRY_CODE=968

# النسخ الاحتياطي التلقائي: كل كم ساعة، وكم نسخة يُحتفظ بها
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# أقصى عدد طلبات للمعلمين في الدقيقة لكل مدرسة
TEACHER_RATE_LIMIT=1500

# المنفذ الداخلي عند التشغيل خلف خادم ويب آخر (docker-compose.app-only.yml)
APP_PORT=3100

# اتركه true في الإنتاج. اجعله false فقط للتجربة بدون HTTPS
# COOKIE_SECURE=true
