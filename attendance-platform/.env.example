# انسخ هذا الملف إلى .env وعدّل القيم

# اسم النطاق الذي سيعمل عليه الموقع (يجب أن يشير سجل DNS من نوع A إلى عنوان الخادم)
DOMAIN=attendance.example.com

# المنطقة الزمنية للمدارس (لتحديد تاريخ "اليوم")
SCHOOL_TZ=Asia/Riyadh

# النسخ الاحتياطي التلقائي: كل كم ساعة، وكم نسخة يُحتفظ بها
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# أقصى عدد طلبات للمعلمين في الدقيقة لكل مدرسة
TEACHER_RATE_LIMIT=1500

# اتركه true في الإنتاج. اجعله false فقط للتجربة بدون HTTPS
# COOKIE_SECURE=true
APP_PORT=3100
